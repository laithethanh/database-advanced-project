direction LR
class Account {
  +account_id BIGINT PK
  +email VARCHAR UQ
  +password_hash VARCHAR
  +full_name VARCHAR
  +phone VARCHAR
  +status ENUM
  +created_at DATETIME
  +updated_at DATETIME
}
class Customer {
  +account_id BIGINT PK/FK
  +customer_code VARCHAR UQ
}
class Seller {
  +account_id BIGINT PK/FK
  +seller_code VARCHAR UQ
  +shop_name VARCHAR UQ
  +shop_status ENUM
  +created_at DATETIME
}
class Address {
  +address_id BIGINT PK
  +customer_id BIGINT FK
  +recipient_name VARCHAR
  +phone VARCHAR
  +line1 VARCHAR
  +ward VARCHAR
  +district VARCHAR
  +city VARCHAR
  +province VARCHAR
  +postal_code VARCHAR
  +is_default BOOLEAN
}
class Category {
  +category_id BIGINT PK
  +parent_category_id BIGINT FK
  +name VARCHAR
  +slug VARCHAR UQ
  +status ENUM
  +created_at DATETIME
}
class Product {
  +product_id BIGINT PK
  +category_id BIGINT FK
  +name VARCHAR
  +slug VARCHAR UQ
  +description TEXT
  +brand VARCHAR
  +status ENUM
  +created_at DATETIME
  +updated_at DATETIME
}
class Warehouse {
  +warehouse_id BIGINT PK
  +code VARCHAR UQ
  +name VARCHAR
  +address_text VARCHAR
  +status ENUM
}
class ProductVariant {
  +variant_id BIGINT PK
  +warehouse_id BIGINT FK
  +product_id BIGINT FK
  +sku VARCHAR UQ
  +color VARCHAR
  +size VARCHAR
  +price DECIMAL
  +compare_at_price DECIMAL
  +warehouse_quantity INT
  +status ENUM
}
class Inventory {
  +seller_id BIGINT PK/FK
  +variant_id BIGINT PK/FK
  +quantity_on_hand INT
  +reserved_quantity INT
  +reorder_level INT
  +updated_at DATETIME
}
class Cart {
  +cart_id BIGINT PK
  +customer_id BIGINT FK
  +status ENUM
  +created_at DATETIME
  +updated_at DATETIME
}
class CartItem {
  +cart_id BIGINT PK/FK
  +seller_id BIGINT PK/FK
  +variant_id BIGINT PK/FK
  +quantity INT
  +added_at DATETIME
}
class Promotion {
  +promotion_id BIGINT PK
  +code VARCHAR UQ
  +name VARCHAR
  +promotion_type ENUM
  +discount_value DECIMAL
  +min_order_amount DECIMAL
  +max_discount DECIMAL
  +start_at DATETIME
  +end_at DATETIME
  +status ENUM
  +usage_limit INT
  +used_count INT
}
class PromotionProduct {
  +promotion_id BIGINT PK/FK
  +product_id BIGINT PK/FK
}
class PromotionCategory {
  +promotion_id BIGINT PK/FK
  +category_id BIGINT PK/FK
}
class Order {
  +order_id BIGINT PK
  +order_number VARCHAR UQ
  +customer_id BIGINT FK
  +status ENUM
  +recipient_name VARCHAR
  +recipient_phone VARCHAR
  +shipping_address VARCHAR
  +subtotal DECIMAL
  +discount_total DECIMAL
  +shipping_fee DECIMAL
  +grand_total DECIMAL
  +placed_at DATETIME
  +created_at DATETIME
  +updated_at DATETIME
}
class OrderItem {
  +order_item_id BIGINT PK
  +order_id BIGINT FK
  +seller_id BIGINT FK*
  +variant_id BIGINT FK*
  +product_name_snapshot VARCHAR
  +sku_snapshot VARCHAR
  +unit_price DECIMAL
  +quantity INT
  +line_discount DECIMAL
  +line_total DECIMAL
}
class OrderPromotion {
  +order_id BIGINT PK/FK
  +promotion_id BIGINT PK/FK
  +discount_amount DECIMAL
  +promotion_code_snapshot VARCHAR
}
class Payment {
  +payment_id BIGINT PK
  +order_id BIGINT FK
  +provider VARCHAR
  +transaction_ref VARCHAR UQ
  +amount DECIMAL
  +status ENUM
  +paid_at DATETIME
  +created_at DATETIME
}
class Shipment {
  +shipment_id BIGINT PK
  +order_id BIGINT FK
  +carrier VARCHAR
  +tracking_number VARCHAR UQ
  +status ENUM
  +shipped_at DATETIME
  +delivered_at DATETIME
}
class Review {
  +review_id BIGINT PK
  +product_id BIGINT FK
  +customer_id BIGINT FK
  +order_item_id BIGINT FK
  +rating TINYINT
  +title VARCHAR
  +body TEXT
  +status ENUM
  +created_at DATETIME
  +updated_at DATETIME
}
