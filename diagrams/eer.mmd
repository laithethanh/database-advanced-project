class Inventory { +warehouse_id PK/FK +variant_id PK/FK +quantity_on_hand +reserved_quantity }
class Promotion { +promotion_id PK +code UQ +start_at +end_at }
class PromotionProduct { +promotion_id PK/FK +product_id PK/FK }
class PromotionCategory { +promotion_id PK/FK +category_id PK/FK }
class Order { +order_id PK +order_number UQ +status +grand_total }
class OrderItem { +order_item_id PK +order_id FK +variant_id FK +unit_price +quantity }
class OrderPromotion { +order_id PK/FK +promotion_id PK/FK +discount_amount }
class Payment { +payment_id PK +order_id FK +status }
class Shipment { +shipment_id PK +order_id FK +status }
class Review { +review_id PK +product_id FK +customer_id FK +rating }
