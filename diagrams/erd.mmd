    ACCOUNT {
      BIGINT account_id PK
      VARCHAR email UK
      VARCHAR password_hash
      VARCHAR full_name
      VARCHAR phone
      ENUM status
      DATETIME created_at
      DATETIME updated_at
    }
    CUSTOMER {
      BIGINT account_id PK,FK
      VARCHAR customer_code UK
    }
    SELLER {
      BIGINT account_id PK,FK
      VARCHAR seller_code UK
      VARCHAR shop_name UK
      ENUM shop_status
      DATETIME created_at
    }
    ADDRESS {
      BIGINT address_id PK
      BIGINT customer_id FK
      VARCHAR recipient_name
      VARCHAR phone
      VARCHAR line1
      VARCHAR ward
      VARCHAR district
      VARCHAR city
      VARCHAR province
      VARCHAR postal_code
      BOOLEAN is_default
    }
    CATEGORY {
      BIGINT category_id PK
      BIGINT parent_category_id FK
      VARCHAR name
      VARCHAR slug UK
      ENUM status
      DATETIME created_at
    }
    PRODUCT {
      BIGINT product_id PK
      BIGINT category_id FK
      VARCHAR name
      VARCHAR slug UK
      TEXT description
      VARCHAR brand
      ENUM status
      DATETIME created_at
      DATETIME updated_at
    }
    WAREHOUSE {
      BIGINT warehouse_id PK
      VARCHAR code UK
      VARCHAR name
      VARCHAR address_text
      ENUM status
    }
    PRODUCT_VARIANT {
      BIGINT variant_id PK
      BIGINT warehouse_id FK
      BIGINT product_id FK
      VARCHAR sku UK
      VARCHAR color
      VARCHAR size
      DECIMAL price
      DECIMAL compare_at_price
      INT warehouse_quantity
      ENUM status
    }
    INVENTORY {
      BIGINT seller_id PK,FK
      BIGINT variant_id PK,FK
      INT quantity_on_hand
      INT reserved_quantity
      INT reorder_level
      DATETIME updated_at
    }
    CART {
      BIGINT cart_id PK
      BIGINT customer_id FK
      ENUM status
      DATETIME created_at
      DATETIME updated_at
    }
    CART_ITEM {
      BIGINT cart_id PK,FK
      BIGINT seller_id PK,FK
      BIGINT variant_id PK,FK
      INT quantity
      DATETIME added_at
    }
    PROMOTION {
      BIGINT promotion_id PK
      VARCHAR code UK
      VARCHAR name
      ENUM promotion_type
      DECIMAL discount_value
      DECIMAL min_order_amount
      DECIMAL max_discount
      DATETIME start_at
      DATETIME end_at
      ENUM status
      INT usage_limit
      INT used_count
    }
    PROMOTION_PRODUCT {
      BIGINT promotion_id PK,FK
      BIGINT product_id PK,FK
    }
    PROMOTION_CATEGORY {
      BIGINT promotion_id PK,FK
      BIGINT category_id PK,FK
    }
    ORDERS {
      BIGINT order_id PK
      VARCHAR order_number UK
      BIGINT customer_id FK
      ENUM status
      VARCHAR recipient_name
      VARCHAR recipient_phone
      VARCHAR shipping_address
      DECIMAL subtotal
      DECIMAL discount_total
      DECIMAL shipping_fee
      DECIMAL grand_total
      DATETIME placed_at
      DATETIME created_at
      DATETIME updated_at
    }
    ORDER_ITEM {
      BIGINT order_item_id PK
      BIGINT order_id FK
      BIGINT seller_id FK
      BIGINT variant_id FK
      VARCHAR product_name_snapshot
      VARCHAR sku_snapshot
      DECIMAL unit_price
      INT quantity
      DECIMAL line_discount
      DECIMAL line_total
    }
    ORDER_PROMOTION {
      BIGINT order_id PK,FK
      BIGINT promotion_id PK,FK
      DECIMAL discount_amount
      VARCHAR promotion_code_snapshot
    }
    PAYMENT {
      BIGINT payment_id PK
      BIGINT order_id FK
      VARCHAR provider
      VARCHAR transaction_ref UK
      DECIMAL amount
      ENUM status
      DATETIME paid_at
      DATETIME created_at
    }
    SHIPMENT {
      BIGINT shipment_id PK
      BIGINT order_id FK
      VARCHAR carrier
      VARCHAR tracking_number UK
      ENUM status
      DATETIME shipped_at
      DATETIME delivered_at
    }
    REVIEW {
      BIGINT review_id PK
      BIGINT product_id FK
      BIGINT customer_id FK
      BIGINT order_item_id FK
      TINYINT rating
      VARCHAR title
      TEXT body
      ENUM status
      DATETIME created_at
      DATETIME updated_at
    }
